# vLLM K80 Runtime Image (local source)
# Builds this checkout on top of the builder image with the deps, xformers and
# vllm stages of tools/k80-host/setup.sh. Layers go from least to most often
# changed, so a source edit rebuilds only the last stage.
#
# Requires: vllm37-builder image (built from docker/k80/builder/Dockerfile)
#
# Build (from repo root; `make build-local` does this):
#   docker build -t vllm37-local -f docker/k80/runtime/Dockerfile.local .

ARG BUILDER_IMAGE=vllm37-builder
FROM ${BUILDER_IMAGE}

ARG MAX_JOBS=4
# Revision of the source this image was built from. k80-runtime.yml reads this
# label to decide whether to rebuild when the branch moves ahead of the image.
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${GIT_SHA}

WORKDIR /usr/local/src/vllm37

# 1. Python dependencies
COPY requirements/common.txt requirements/common.txt
COPY docker/k80/requirements.txt docker/k80/constraints.txt docker/k80/
COPY tools/k80-host tools/k80-host
RUN JOBS=${MAX_JOBS} tools/k80-host/setup.sh deps

# 2. Patched xformers (CPU-only compile, ~8 min)
COPY docker/k80/xformers-build docker/k80/xformers-build
COPY docker/k80/xformers-patches docker/k80/xformers-patches
COPY docker/k80/cutlass-patches docker/k80/cutlass-patches
RUN JOBS=${MAX_JOBS} tools/k80-host/setup.sh xformers && \
    rm -rf ${K80_PREFIX}/src/xformers-build

# 3. vLLM from this checkout
COPY . .
RUN K80_EDITABLE=0 JOBS=${MAX_JOBS} tools/k80-host/setup.sh vllm

# Leave the source tree so Python imports the installed package, not ./vllm.
WORKDIR /workspace

# ============================================================================
# Runtime configuration (docker-compose.yml adds only per-run settings)
# ============================================================================
# NVIDIA Container Toolkit requires these to expose GPUs inside the container
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    VLLM_USE_V1=0 \
    VLLM_ATTENTION_BACKEND=XFORMERS \
    TORCHDYNAMO_DISABLE=1 \
    NCCL_P2P_DISABLE=1 \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    PYTHONUNBUFFERED=1
# VLLM_ATTENTION_BACKEND: the patched xformers cutlassF kernels run on sm_37.
# TORCHDYNAMO_DISABLE: dynamo/Inductor compile through Triton, which cannot target sm_37.
# NCCL_P2P_DISABLE: K80 is PCIe-only; P2P causes kernel timeouts with TP>1.
# VLLM_WORKER_MULTIPROC_METHOD: spawn avoids forking a process that already holds CUDA.

EXPOSE 8000

# stdbuf line-buffers libc stdio so NCCL output is not lost when a run hangs.
ENTRYPOINT ["stdbuf", "-oL", "-eL", "python", "-m", "vllm.entrypoints.openai.api_server"]
# TP=1 by default: TP=4 across both K80 boards can overload the shared CPU
# power cable. Raise it per run (docker-compose.yml reads TP_SIZE).
CMD ["--model", "TinyLlama/TinyLlama-1.1B-Chat-v1.0", \
     "--dtype", "float32", \
     "--enforce-eager", \
     "--tensor-parallel-size", "1", \
     "--max-model-len", "2048", \
     "--gpu-memory-utilization", "0.85", \
     "--swap-space", "0"]
