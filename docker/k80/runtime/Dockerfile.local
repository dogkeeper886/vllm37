# an image built from docker/k80/builder/Dockerfile
ARG BUILDER_IMAGE=vllm37-builder
FROM ${BUILDER_IMAGE}

# a whole number from 1
ARG MAX_JOBS=4
# a git commit hash
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${GIT_SHA}

WORKDIR /usr/local/src/vllm37

COPY requirements/common.txt requirements/common.txt
COPY docker/k80/requirements.txt docker/k80/constraints.txt docker/k80/
COPY tools/k80-host tools/k80-host
RUN JOBS=${MAX_JOBS} tools/k80-host/setup.sh deps

COPY docker/k80/xformers-build docker/k80/xformers-build
COPY docker/k80/xformers-patches docker/k80/xformers-patches
COPY docker/k80/cutlass-patches docker/k80/cutlass-patches
RUN JOBS=${MAX_JOBS} tools/k80-host/setup.sh xformers && \
    rm -rf ${K80_PREFIX}/src/xformers-build

COPY . .
RUN K80_EDITABLE=0 JOBS=${MAX_JOBS} tools/k80-host/setup.sh vllm

WORKDIR /workspace

# NVIDIA_VISIBLE_DEVICES: all, none, void, or GPU indexes or UUIDs,
#                         comma-separated
# NVIDIA_DRIVER_CAPABILITIES: all, or a comma-separated list of compute,
#                             compat32, graphics, utility, video and display
# VLLM_USE_V1: 0; 1 needs compute capability 8.0
# VLLM_ATTENTION_BACKEND: XFORMERS or TORCH_SDPA
# TORCHDYNAMO_DISABLE: 1 turns TorchDynamo off; any other value leaves it on
# NCCL_P2P_LEVEL: LOC, NVL, PIX, PXB, PHB or SYS
# VLLM_WORKER_MULTIPROC_METHOD: spawn, fork or forkserver
# PYTHONUNBUFFERED: any non-empty value turns buffering off
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    VLLM_USE_V1=0 \
    VLLM_ATTENTION_BACKEND=XFORMERS \
    TORCHDYNAMO_DISABLE=1 \
    NCCL_P2P_LEVEL=PIX \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    PYTHONUNBUFFERED=1

# a TCP port, the server's --port (default 8000)
EXPOSE 8000

# -o and -e: L (line), 0 (unbuffered) or a buffer size such as 4K
ENTRYPOINT ["stdbuf", "-oL", "-eL", "python", "-m", "vllm.entrypoints.openai.api_server"]
# --model: a Hugging Face repo id or a local path
# --dtype: float32 or half
# --enforce-eager: present: eager only; absent: CUDA graphs and eager
# --tensor-parallel-size: whole number from 1, at most the host's dies, dividing
#                         the model's attention heads
# --max-model-len: tokens, up to the model's context length
# --gpu-memory-utilization: a fraction of each die's memory, up to 1
# --swap-space: GiB per die, from 0; times the dies, below 70 % of host memory
CMD ["--model", "TinyLlama/TinyLlama-1.1B-Chat-v1.0", \
     "--dtype", "float32", \
     "--enforce-eager", \
     "--tensor-parallel-size", "1", \
     "--max-model-len", "2048", \
     "--gpu-memory-utilization", "0.85", \
     "--swap-space", "0"]
