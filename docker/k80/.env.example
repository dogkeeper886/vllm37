# a whole number from 1
JOBS=4

# a Hugging Face repo id or a local path
MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# float32 or half
DTYPE=float32
# tokens, up to the model's context length
MAX_MODEL_LEN=2048
# a fraction of each die's memory, up to 1
GPU_MEM_UTIL=0.85

# whole number from 1, at most the host's dies, dividing the model's attention
# heads
TP_SIZE=1

# a directory (default ~/.cache/huggingface)
# HF_HOME=/path/to/hf_cache
