# Settings for vllm37.service, read by tools/k80-host/serve.sh.
# install-service.sh copies this file to ~/.config/vllm37/serve.env. Edit that
# copy, then run `systemctl --user restart vllm37`.
# Keep each comment on its own line: systemd takes everything after `=` as
# the value.

# Hugging Face model id. The weights must fit: in float32 about 2B parameters
# on one die and 4B with TP_SIZE=2; in half about twice that.
MODEL=Qwen/Qwen3-0.6B

# Weight and KV cache dtype: float32 or half. half stores 2 bytes per
# parameter and computes in FP32. It decodes faster for one request at a time
# and slower for several at once; see README "FP16 storage".
DTYPE=float32

# Context length in tokens, up to the model's own limit. 16384 is the largest
# value tested on a K80.
MAX_MODEL_LEN=8192

# Tensor parallel size: 1 or 2. 4 has halted this machine.
TP_SIZE=1

# GPU dies to use, as nvidia-smi indexes 0-3, comma-separated. Give TP_SIZE of
# them, and pick dies no other service holds.
CUDA_VISIBLE_DEVICES=0

# Fraction of each die's memory vLLM may take, 0 to 1.
GPU_MEM_UTIL=0.85

# XFORMERS or TORCH_SDPA.
VLLM_ATTENTION_BACKEND=XFORMERS

# TCP port of the OpenAI-compatible API. The vllm37 container also uses 8000.
PORT=8000
