# a profile name in docker/k80/models/ or a path (default none)
#PROFILE=qwen3-0.6b

# a Hugging Face model id or a model directory (default the profile's, else
# TinyLlama/TinyLlama-1.1B-Chat-v1.0)
MODEL=Qwen/Qwen3-0.6B

# float32, half or auto (default the profile's, else float32)
DTYPE=float32

# tokens, up to the model's own limit (default the profile's, else 2048)
MAX_MODEL_LEN=8192

# a die count that divides the model's attention heads (default the profile's,
# else 1)
TP_SIZE=1

# comma-separated die indexes 0-3, TP_SIZE times the profile's pipeline
# parallel size of them (default all)
CUDA_VISIBLE_DEVICES=0

# a fraction above 0, at most 1 (default 0.85)
GPU_MEM_UTIL=0.85

# XFORMERS or TORCH_SDPA (default XFORMERS)
VLLM_ATTENTION_BACKEND=XFORMERS

# a TCP port (default 8000)
PORT=8000
